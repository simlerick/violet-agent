{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "violet-agent",
  "version": "0.1.0",
  "identifier": "com.violet.agent",
  "build": {
    "beforeDevCommand": "npm run dev --prefix src",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix src",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Violet Agent 🌸",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
